#Todas acaban en el navegador, solo claves públicas y restringidas

#Votos y aportaciones compartidos (tabla en supabase/schema.sql), sin esto se guardan en local
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=

#Client Token de Mapillary (MLY|...), solo lo usa scripts/scan_mapillary_signs.py
VITE_MAPILLARY_TOKEN=

#Opcional, sin clave se usa el visor no documentado de Street View
#Necesita Maps Embed API y Street View Static API, restringida por referente HTTP
VITE_GOOGLE_MAPS_API_KEY=

#Sin barra final, para canonical, Open Graph, sitemap y robots.txt
VITE_SITE_URL=https://howfarhome.com

#AdSense opcional, sin el client no se carga publicidad ni se pregunta por ella
#Con el client también se genera /ads.txt en el build
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT=
