# Copia este archivo como .env.local y rellena lo que quieras activar.
# Todas las claves acaban en el navegador: usa solo claves públicas y restringidas.

# Votos compartidos «sí hay cartel / no hay cartel» (supabase.com, plan gratuito).
# Crea la tabla con supabase/schema.sql. Sin esto, los votos se guardan solo en el navegador.
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=

# Client Token de Mapillary (mapillary.com/dashboard/developers, gratis; empieza por MLY|).
# Solo lo usa scripts/scan_mapillary_signs.py en tu PC: la web ya no lo necesita.
VITE_MAPILLARY_TOKEN=

# Opcional: la app ya muestra Street View sin clave con un visor no documentado de Google.
# Para usar la vía oficial, activa "Maps Embed API" y "Street View Static API" en Google Cloud
# y restringe la clave por referente HTTP.
VITE_GOOGLE_MAPS_API_KEY=

# Dominio público de la web, sin barra final. Se usa en canonical, Open Graph, sitemap y robots.txt.
VITE_SITE_URL=https://howfarhome.es

# Google AdSense (opcional). Sin estas dos, no se carga nada de publicidad ni se pregunta por ella.
# Client: ca-pub-XXXXXXXXXXXXXXXX. Slot: el id numérico del bloque de anuncio «display».
# Al definir el client también se genera /ads.txt en el build.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT=
